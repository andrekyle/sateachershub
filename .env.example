# Copy this file to .env and fill in real values. Never commit .env.
# A long random string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL / Nile connection. Any one of these works (priority: NILEDB_URL > POSTGRES_URL > DATABASE_URL).
# postgres:// is auto-rewritten to postgresql:// in config.py.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# POSTGRES_URL=
# NILEDB_URL=
# NILEDB_USER=
# NILEDB_PASSWORD=
# NILEDB_API_URL=
# NILEDB_POSTGRES_URL=
